<?xml version="1.0" encoding="UTF-8"?>
<pretext xmlns:xi="http://www.w3.org/2001/XInclude" xml:lang="en-GB">
  <book xml:id="mathematics-book">
    <title>Mathematics</title>
    <subtitle>Explore, understand, practise</subtitle>
    <frontmatter>
      <preface xml:id="welcome">
        <title>Welcome</title>
        <p>This book is designed to help you learn mathematics, not merely revise it. Explore the questions, make predictions, test ideas, and try the exercises before revealing answers. Junior Cycle (JC) mathematics provides the foundation; Leaving Certificate (LC) chapters contain additional mathematics and refer back to JC rather than repeating it. In multiple-choice questions, your first selection is checked immediately and then locked, so read each option before choosing.</p>
      </preface>
    </frontmatter>

    <part xml:id="part-unifying"><title>Unifying Strand</title>
      <xi:include href="./unifying-strand.ptx" />
    </part>

    <part xml:id="part-number">
      <title>Number</title>
      <xi:include href="./sets-chapter.ptx" />
      <xi:include href="./sequences-chapter.ptx" />
      <xi:include href="./complex-numbers-lc.ptx" />
    </part>

    <part xml:id="part-algebra"><title>Algebra</title>
      <xi:include href="./algebra-jc.ptx" />
      <xi:include href="./algebra-lc.ptx" />
    </part>

    <part xml:id="part-functions"><title>Functions</title>
      <xi:include href="./functions-core.ptx" />
      <xi:include href="./calculus-lc.ptx" />
    </part>

    <part xml:id="part-geometry"><title>Geometry</title>
      <xi:include href="./geometry-core.ptx" />
    </part>

    <part xml:id="part-trigonometry"><title>Trigonometry</title>
      <xi:include href="./trigonometry-chapter.ptx" />
      <xi:include href="./trigonometry-lc.ptx" />
    </part>

    <part xml:id="part-statistics"><title>Statistics</title>
      <xi:include href="./statistics-core.ptx" />
    </part>

    <part xml:id="part-probability"><title>Probability</title>
      <xi:include href="./probability-core.ptx" />
      <xi:include href="./combinatorics-core.ptx" />
    </part>

    <part xml:id="part-specifications">
      <title>Specifications</title>
      <xi:include href="./specifications.ptx" />
    </part>
  </book>
</pretext>
