<?xml version="1.0" encoding="UTF-8"?>
<section xml:id="expansions-like-factors">
  <title>Like Factors</title>
  <p>Expand each product and collect like terms where needed. Attempt each question before revealing the answer.</p>
  <exercise xml:id="expansions-like-factors-q001">
    <statement>
      <p><m>\begin{array}{r}3x+2\\[4pt]5x+4\\[-2pt]\hline\end{array}</m></p>
    </statement>
    <answer><p><m>15x^{2}+22x+8</m></p></answer>
  </exercise>
  <exercise xml:id="expansions-like-factors-q002">
    <statement>
      <p><m>\begin{array}{r}13x-5\\[4pt]2x+3\\[-2pt]\hline\end{array}</m></p>
    </statement>
    <answer><p><m>26x^{2}+29x-15</m></p></answer>
  </exercise>
  <exercise xml:id="expansions-like-factors-q003">
    <statement>
      <p><m>\begin{array}{r}7x-2\\[4pt]5x-3\\[-2pt]\hline\end{array}</m></p>
    </statement>
    <answer><p><m>35x^{2}-31x+6</m></p></answer>
  </exercise>
  <exercise xml:id="expansions-like-factors-q004">
    <statement>
      <p><m>\begin{array}{r}5x-2\\[4pt]5x+2\\[-2pt]\hline\end{array}</m></p>
    </statement>
    <answer><p><m>25x^{2}-4</m></p></answer>
  </exercise>
  <exercise xml:id="expansions-like-factors-q005">
    <statement>
      <p><m>\begin{array}{r}11x-5\\[4pt]2x+3\\[-2pt]\hline\end{array}</m></p>
    </statement>
    <answer><p><m>22x^{2}+23x-15</m></p></answer>
  </exercise>
  <exercise xml:id="expansions-like-factors-q006">
    <statement>
      <p><m>\begin{array}{r}3x^2-2\\[4pt]x^2-5\\[-2pt]\hline\end{array}</m></p>
    </statement>
    <answer><p><m>3x^{4}-17x^{2}+10</m></p></answer>
  </exercise>
</section>
