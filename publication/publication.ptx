<?xml version="1.0" encoding="UTF-8"?>
<publication>
  <source>
    <directories external="../assets"/>
  </source>
  <common>
    <!-- Show Parts, chapters and sections in the contents panel. -->
    <tableofcontents level="3"/>
  </common>
  <html favicon="simple">
    <!-- Focus navigation on the current page; visitors can expand/collapse branches. -->
    <tableofcontents focused="yes" preexpanded-levels="1"/>
    <baseurl href="https://ronandownes.github.io/book/"/>
    <brandlogo source="four-dots.svg" url="https://ronandownes.github.io/book/"/>
    <!-- Native PreTeXt textbook layout; colours align with Maths Apps. -->
    <css theme="default-modern" palette="blue-green" provide-dark-mode="no"/>
  </html>
</publication>
